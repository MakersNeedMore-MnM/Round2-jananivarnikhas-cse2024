void updateNormalRed(
  JunctionState &j,
  SimpleLCD &lcd,
  String name
) {

  if (j.active)
    return;

  static unsigned long lastRedUpdate1 = 0;
  static unsigned long lastRedUpdate2 = 0;
  static unsigned long lastRedUpdate3 = 0;

  unsigned long now =
    millis();

  if (name == "J1") {

    if (now - lastRedUpdate1 >= 1000) {

      lastRedUpdate1 = now;

      static int red1 = 60;

      red1--;

      if (red1 <= 0)
        red1 = 60;

      lcdRed(
        lcd,
        name,
        red1
      );
    }
  }


  else if (name == "J2") {

    if (now - lastRedUpdate2 >= 1000) {

      lastRedUpdate2 = now;

      static int red2 = 60;

      red2--;

      if (red2 <= 0)
        red2 = 60;

      lcdRed(
        lcd,
        name,
        red2
      );
    }
  }


  else if (name == "J3") {

    if (now - lastRedUpdate3 >= 1000) {

      lastRedUpdate3 = now;

      static int red3 = 60;

      red3--;

      if (red3 <= 0)
        red3 = 60;

      lcdRed(
        lcd,
        name,
        red3
      );
    }
  }
}



void updateGreenCountdown(
  JunctionState &j,
  SimpleLCD &lcd,
  String name
) {

  if (!j.active)
    return;


  unsigned long elapsed =
    (millis() - j.startTime) / 1000;


  int remaining =
    j.duration - elapsed;


  if (remaining <= 0) {

    j.active = false;

    j.signal = "RED";


    lcdRed(
      lcd,
      name,
      60
    );


    dashboardEvent(
      "RED",
      name
    );


    return;
  }


  if (remaining != j.lastSecond) {

    j.lastSecond =
      remaining;


    lcdGreen(
      lcd,
      name,
      remaining
    );


    Serial.print(
      "LIFELANE_COUNTDOWN:"
    );

    Serial.print(
      name
    );

    Serial.print(
      ":"
    );

    Serial.println(
      remaining
    );
  }
}



void updateCountdown() {

  updateGreenCountdown(
    junction1,
    lcdJ1,
    "J1"
  );

  updateGreenCountdown(
    junction2,
    lcdJ2,
    "J2"
  );

  updateGreenCountdown(
    junction3,
    lcdJ3,
    "J3"
  );


  updateNormalRed(
    junction1,
    lcdJ1,
    "J1"
  );

  updateNormalRed(
    junction2,
    lcdJ2,
    "J2"
  );

  updateNormalRed(
    junction3,
    lcdJ3,
    "J3"
  );
}



void onReceive(
  const uint8_t *mac,
  const uint8_t *data,
  int len
) {

  String message = "";


  for (
    int i = 0;
    i < len;
    i++
  ) {

    message +=
      (char)data[i];
  }


  message.trim();


  Serial.print(
    "ESP-NOW RECEIVED: "
  );

  Serial.println(
    message
  );



  if (
    message ==
    "EMERGENCY_J1"
  ) {

    Serial.println(
      "=============================="
    );

    Serial.println(
      "EMERGENCY REQUEST RECEIVED"
    );

    Serial.println(
      "=============================="
    );


    Serial.println(
      "Emergency Location: HOUSE 1"
    );

    Serial.println(
      "Ambulance Selected: A1"
    );

    Serial.println(
      "Initial Route: HOUSE 1 -> J1 -> J2 -> HOSPITAL 1"
    );


    dashboardEvent(
      "EMERGENCY",
      "J1"
    );

    dashboardEvent(
      "LOCATION",
      "HOUSE_1"
    );

    dashboardEvent(
      "AMBULANCE",
      "A1"
    );

    dashboardEvent(
      "ROUTE",
      "J1_J2_HOSPITAL1"
    );


    // Emergency green
    startJ1(15);

    return;
  }



  if (
    message ==
    "EMERGENCY_J2"
  ) {

    Serial.println(
      "EMERGENCY AT J2"
    );


    dashboardEvent(
      "EMERGENCY",
      "J2"
    );

    dashboardEvent(
      "LOCATION",
      "HOUSE_2"
    );

    dashboardEvent(
      "AMBULANCE",
      "A1"
    );


    startJ2(15);

    return;
  }



  if (
    message ==
    "EMERGENCY_J3"
  ) {

    Serial.println(
      "EMERGENCY AT J3"
    );


    dashboardEvent(
      "EMERGENCY",
      "J3"
    );

    dashboardEvent(
      "LOCATION",
      "HOUSE_3"
    );

    dashboardEvent(
      "AMBULANCE",
      "A1"
    );


    startJ3(15);

    return;
  }



  if (
    message ==
    "J1_PASSED"
  ) {

    Serial.println(
      "Ambulance passed J1"
    );


    dashboardEvent(
      "PASSED",
      "J1"
    );


    stopJ1();


    delay(300);


    Serial.println(
      "Activating J2 green corridor"
    );


    startJ2(25);

    return;
  }



  if (
    message ==
    "ACCIDENT_J2"
  ) {

    Serial.println(
      "=============================="
    );

    Serial.println(
      "ACCIDENT DETECTED AT J2"
    );

    Serial.println(
      "=============================="
    );


    dashboardEvent(
      "ACCIDENT",
      "J2"
    );


    dashboardEvent(
      "BLOCKED",
      "J2"
    );


    stopJ2();


    sendToJunction(
      J2_MAC,
      "ACCIDENT_J2"
    );


    dashboardEvent(
      "REROUTE",
      "J1_J3_HOSPITAL2"
    );


    Serial.println(
      "New Route: J1 -> J3 -> HOSPITAL 2"
    );


    delay(300);


    startJ3(15);

    return;
  }



  if (
    message ==
    "J2_PASSED"
  ) {

    Serial.println(
      "Ambulance passed J2"
    );


    dashboardEvent(
      "PASSED",
      "J2"
    );


    stopJ2();

    return;
  }



  if (
    message ==
    "J3_PASSED"
  ) {

    Serial.println(
      "Ambulance passed J3"
    );


    dashboardEvent(
      "PASSED",
      "J3"
    );


    stopJ3();


    dashboardEvent(
      "HOSPITAL",
      "HOSPITAL_2"
    );


    Serial.println(
      "Ambulance reached Hospital 2"
    );


    return;
  }



  if (
    message ==
      "J1_TRAFFIC_ENTRY" ||
    message ==
      "J2_TRAFFIC_ENTRY" ||
    message ==
      "J3_TRAFFIC_ENTRY"
  ) {

    String j =
      message.substring(0, 2);


    Serial.print(
      "IR ENTRY DETECTED AT "
    );

    Serial.println(
      j
    );


    dashboardEvent(
      "IR_ENTRY",
      j
    );

    return;
  }



  if (
    message ==
      "J1_TRAFFIC_EXIT" ||
    message ==
      "J2_TRAFFIC_EXIT" ||
    message ==
      "J3_TRAFFIC_EXIT"
  ) {

    String j =
      message.substring(0, 2);


    Serial.print(
      "IR EXIT DETECTED AT "
    );

    Serial.println(
      j
    );


    dashboardEvent(
      "IR_EXIT",
      j
    );

    return;
  }



  if (
    message.indexOf(
      "TRAFFIC"
    ) >= 0
  ) {

    dashboardEvent(
      "TRAFFIC",
      message
    );

    return;
  }
}



void processSerialCommand(
  String command
) {

  command.trim();


  Serial.print(
    "PYTHON COMMAND: "
  );

  Serial.println(
    command
  );



  if (
    command.startsWith(
      "TIMED_GREEN_J1,"
    )
  ) {

    int seconds =
      command.substring(
        15
      ).toInt();


    startJ1(
      seconds
    );

    return;
  }


  if (
    command.startsWith(
      "TIMED_GREEN_J2,"
    )
  ) {

    int seconds =
      command.substring(
        15
      ).toInt();


    startJ2(
      seconds
    );

    return;
  }


  if (
    command.startsWith(
      "TIMED_GREEN_J3,"
    )
  ) {

    int seconds =
      command.substring(
        15
      ).toInt();


    startJ3(
      seconds
    );

    return;
  }


  if (
    command ==
    "NORMAL_ALL"
  ) {

    stopJ1();
    stopJ2();
    stopJ3();

    return;
  }


  if (
    command ==
    "NORMAL_J1"
  ) {

    stopJ1();

    return;
  }



  if (
    command ==
    "NORMAL_J2"
  ) {

    stopJ2();

    return;
  }



  if (
    command ==
    "NORMAL_J3"
  ) {

    stopJ3();

    return;
  }



  if (
    command ==
    "BLOCK_J2"
  ) {

    stopJ2();

    sendToJunction(
      J2_MAC,
      "ACCIDENT_J2"
    );

    dashboardEvent(
      "BLOCKED",
      "J2"
    );

    return;
  }


  if (
    command ==
    "CLEAR_J2"
  ) {

    sendToJunction(
      J2_MAC,
      "CLEAR_J2"
    );

    dashboardEvent(
      "CLEAR",
      "J2"
    );

    return;
  }
}



void setup() {

  Serial.begin(
    115200
  );


  delay(
    1000
  );


  Serial.println();
  Serial.println(
    "======================================"
  );

  Serial.println(
    "LIFELANE AI - A1 CENTRAL CONTROLLER"
  );

  Serial.println(
    "======================================"
  );



  Serial.println(
    "Initializing LCD J1..."
  );

  lcdJ1.begin();

  lcdJ1.backlightOn();


  Serial.println(
    "Initializing LCD J2..."
  );

  lcdJ2.begin();

  lcdJ2.backlightOn();


  Serial.println(
    "Initializing LCD J3..."
  );

  lcdJ3.begin();

  lcdJ3.backlightOn();


  lcdTest();



  lcdRed(
    lcdJ1,
    "J1",
    60
  );

  lcdRed(
    lcdJ2,
    "J2",
    60
  );

  lcdRed(
    lcdJ3,
    "J3",
    60
  );



  junction1.active =
    false;

  junction2.active =
    false;

  junction3.active =
    false;


  junction1.signal =
    "RED";

  junction2.signal =
    "RED";

  junction3.signal =
    "RED";



  WiFi.mode(
    WIFI_STA
  );


  Serial.print(
    "A1 MAC: "
  );

  Serial.println(
    WiFi.macAddress()
  );



  if (
    esp_now_init() != ESP_OK
  ) {

    Serial.println(
      "ESP-NOW INIT FAILED"
    );

    return;
  }



  esp_now_peer_info_t peer1 =
    {};

  memcpy(
    peer1.peer_addr,
    J1_MAC,
    6
  );

  peer1.channel =
    0;

  peer1.encrypt =
    false;


  if (
    esp_now_add_peer(
      &peer1
    ) != ESP_OK
  ) {

    Serial.println(
      "J1 PEER FAILED"
    );
  }



  esp_now_peer_info_t peer2 =
    {};

  memcpy(
    peer2.peer_addr,
    J2_MAC,
    6
  );

  peer2.channel =
    0;

  peer2.encrypt =
    false;


  if (
    esp_now_add_peer(
      &peer2
    ) != ESP_OK
  ) {

    Serial.println(
      "J2 PEER FAILED"
    );
  }



  esp_now_peer_info_t peer3 =
    {};

  memcpy(
    peer3.peer_addr,
    J3_MAC,
    6
  );

  peer3.channel =
    0;

  peer3.encrypt =
    false;


  if (
    esp_now_add_peer(
      &peer3
    ) != ESP_OK
  ) {

    Serial.println(
      "J3 PEER FAILED"
    );
  }



  esp_now_register_recv_cb(
    onReceive
  );


  Serial.println(
    "ESP-NOW READY"
  );

  Serial.println(
    "Dashboard events enabled"
  );

  Serial.println(
    "A1 READY"
  );

  Serial.println(
    "======================================"
  );
}



void loop() {

  updateCountdown();


  if (
    Serial.available()
  ) {

    String command =
      Serial.readStringUntil(
        '\n'
      );


    processSerialCommand(
      command
    );
