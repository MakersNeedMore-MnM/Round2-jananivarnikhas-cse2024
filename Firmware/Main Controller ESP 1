class SimpleLCD {

  private:

    int SDA_PIN;
    int SCL_PIN;
    uint8_t address;

    uint8_t backlight = 0x08;

    void i2cStart() {

      pinMode(SDA_PIN, OUTPUT);
      pinMode(SCL_PIN, OUTPUT);

      digitalWrite(SDA_PIN, HIGH);
      digitalWrite(SCL_PIN, HIGH);

      delayMicroseconds(5);

      digitalWrite(SDA_PIN, LOW);

      delayMicroseconds(5);

      digitalWrite(SCL_PIN, LOW);
    }


    void i2cStop() {

      pinMode(SDA_PIN, OUTPUT);

      digitalWrite(SDA_PIN, LOW);
      digitalWrite(SCL_PIN, HIGH);

      delayMicroseconds(5);

      digitalWrite(SDA_PIN, HIGH);

      delayMicroseconds(5);
    }


    bool i2cWriteByte(uint8_t data) {

      for (int i = 7; i >= 0; i--) {

        digitalWrite(
          SDA_PIN,
          (data >> i) & 0x01
        );

        delayMicroseconds(2);

        digitalWrite(SCL_PIN, HIGH);

        delayMicroseconds(4);

        digitalWrite(SCL_PIN, LOW);

        delayMicroseconds(2);
      }


      pinMode(SDA_PIN, INPUT_PULLUP);

      digitalWrite(SCL_PIN, HIGH);

      delayMicroseconds(4);

      bool ack = !digitalRead(SDA_PIN);

      digitalWrite(SCL_PIN, LOW);

      pinMode(SDA_PIN, OUTPUT);

      return ack;
    }


    bool writePCF(uint8_t data) {

      i2cStart();

      bool ack = i2cWriteByte(
        (address << 1) | 0
      );

      if (ack) {
        i2cWriteByte(data);
      }

      i2cStop();

      return ack;
    }


    void writeNibble(
      uint8_t nibble,
      bool rs
    ) {

      uint8_t data = 0;

      data |= (nibble & 0xF0);

      if (rs)
        data |= 0x01;


      data |= backlight;


      writePCF(
        data | 0x04
      );

      delayMicroseconds(2);


      writePCF(
        data & ~0x04
      );

      delayMicroseconds(50);
    }


    void sendByte(
      uint8_t value,
      bool rs
    ) {

      writeNibble(
        value & 0xF0,
        rs
      );

      writeNibble(
        (value << 4) & 0xF0,
        rs
      );
    }


  public:

    SimpleLCD(
      int sda,
      int scl,
      uint8_t addr
    ) {

      SDA_PIN = sda;
      SCL_PIN = scl;
      address = addr;
    }


    void begin() {

      pinMode(
        SDA_PIN,
        OUTPUT
      );

      pinMode(
        SCL_PIN,
        OUTPUT
      );

      digitalWrite(
        SDA_PIN,
        HIGH
      );

      digitalWrite(
        SCL_PIN,
        HIGH
      );

      delay(100);

      writeNibble(
        0x30,
        false
      );

      delay(5);


      writeNibble(
        0x30,
        false
      );

      delayMicroseconds(150);


      writeNibble(
        0x30,
        false
      );

      delayMicroseconds(150);


      writeNibble(
        0x20,
        false
      );

      delayMicroseconds(150);


      sendByte(
        0x28,
        false
      );

      sendByte(
        0x0C,
        false
      );

      sendByte(
        0x06,
        false
      );

      sendByte(
        0x01,
        false
      );

      delay(5);
    }


    void clear() {

      sendByte(
        0x01,
        false
      );

      delay(3);
    }


    void setCursor(
      uint8_t col,
      uint8_t row
    ) {

      uint8_t addr;

      if (row == 0)
        addr = 0x00 + col;
      else
        addr = 0x40 + col;

      sendByte(
        0x80 | addr,
        false
      );
    }


    void print(
      const char *text
    ) {

      while (*text) {

        sendByte(
          *text,
          true
        );

        text++;
      }
    }


    void print(
      String text
    ) {

      for (
        unsigned int i = 0;
        i < text.length();
        i++
      ) {

        sendByte(
          text[i],
          true
        );
      }
    }


    void backlightOn() {

      backlight = 0x08;

      writePCF(backlight);
    }


    void backlightOff() {

      backlight = 0x00;

      writePCF(backlight);
    }
};


