void dashboardEvent(
  String type,
  String value
) {

  Serial.print(
    "LIFELANE_EVENT:"
  );

  Serial.print(
    type
  );

  Serial.print(
    ":"
  );

  Serial.println(
    value
  );
}



void sendToJunction(
  uint8_t *mac,
  String message
) {

  esp_err_t result = esp_now_send(
    mac,
    (uint8_t *)message.c_str(),
    message.length() + 1
  );

  Serial.print(
    "ESP-NOW SEND: "
  );

  Serial.println(
    message
  );

  if (result != ESP_OK) {

    Serial.print(
      "ESP-NOW SEND ERROR: "
    );

    Serial.println(
      result
    );
  }
}


void lcdRed(
  SimpleLCD &lcd,
  String junction,
  int seconds
) {

  lcd.clear();

  lcd.setCursor(
    0,
    0
  );

  lcd.print(
    junction
  );

  lcd.setCursor(
    0,
    1
  );

  lcd.print(
    "RED   TIME:"
  );

  if (seconds >= 0) {

    if (seconds < 10)
      lcd.print(" ");

    lcd.print(
      String(seconds)
    );

  } else {

    lcd.print(
      "--"
    );
  }
}



