void startJ1(
  int seconds
) {

  if (seconds <= 0)
    seconds = 1;

  junction1.active = true;

  junction1.startTime =
    millis();

  junction1.duration =
    seconds;

  junction1.lastSecond =
    seconds;

  junction1.signal =
    "GREEN";


  lcdGreen(
    lcdJ1,
    "J1",
    seconds
  );


  sendToJunction(
    J1_MAC,
    "TIMED_GREEN_J1," +
    String(seconds)
  );


  dashboardEvent(
    "GREEN",
    "J1"
  );
}


